# ===== APIキー（このファイルを .env という名前でコピーして記入。.env はコミットしない） =====
# Gemini: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# ElevenLabs: https://elevenlabs.io/app/settings/api-keys
#   （権限: Text to Speech と Voices の読み取りを有効に）
ELEVENLABS_API_KEY=
# Unsplash: https://unsplash.com/oauth/applications → New Application → Access Key
#   未設定でも動きます（代替の写真サービスを使用）
UNSPLASH_ACCESS_KEY=

# ===== 任意設定 =====
# Gemini のモデル（見つからない場合は自動で利用可能な Flash 系に切替）
GEMINI_MODEL=gemini-flash-latest
# ElevenLabs のモデル（eleven_v4_turbo = 既定 / eleven_v4 = 最高品質 / eleven_flash_v2_5 = 高速・安価）
ELEVENLABS_MODEL=eleven_v4_turbo
# 既定の声（空欄なら設定画面で選択）
ELEVENLABS_VOICE_ID=
PORT=8765
